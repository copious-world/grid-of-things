{
    "template_file" : "template/people/index.html",
    "output_file" : "test/index_p.html",
    "funcs" : {
        "$gen$imports(${entrys_entry_classes})" : {
            "${el}" : "entrys_entry_classes",
            "template" : "\timport ${el}_template from \"./tpl_p/partial/${el}_list.js\";"
        },
        "$gen$imports_map(${entrys_entry_classes})" : {
            "${el}" : "entrys_entry_classes",
            "template" : "\t\t\"${el}\" : ${el}_template",
            "sep" : ","
        },
        "$gen$imports_value_map(${entrys_entry_proto})" : {
            "${el}" : "entrys_entry_proto",
            "${val}" : "t[${el}]",
            "template" : "\t\t\"${el}\" : ${val}",
            "sep" : ","
        },
        "$gen$imports_value_map(${contact_proto})" : {
            "${el}" : "contact_proto",
            "${val}" : "t[${el}]",
            "template" : "\t\t\"${el}\" : ${val}",
            "sep" : ","
        },
        "$gen$css_select(${entrys_entry_classes})" : {
            "${el}" : "entrys_entry_classes",
            "template" : "\t.${el}_check_select {\n\t\tborder:solid 1px rgba(255, 0, 0, 0.438);\n\t}"
        },
        "$load$category_css_fields(entrys-entry-properties.css)" : {
            "file" : "template/people/entrys-entry-properties.css"
        },
        "$load$category_css_fields(edit-entrys-entry-properties.css)" : {
            "file" : "template/people/edit-entrys-entry-properties.css"
        },
        "$load$category_css_fields(contact-properties.css)" : {
            "file" : "template/people/contact-properties.css"
        },
        "$load$imports(${entries_list_classes},body_panels_tmpl.html)" : {
            "${el}" : "entries_list_classes",
            "file" : "template/people/body_panels_tmpl.html"
        }, 
        "$load$imports(${entries_list_classes},view_opener.js)" : {
            "${el}" : "entries_list_classes",
            "file" : "template/people/view_opener.js"
        }, 
        "$load$category_css(${entrys_entry_classes},mtype_css_template.css)" : {
            "${el}" : "entries_list_classes",
            "file" : "template/people/mtype_css_template.css"
        },
        "$load_with_ops:nav_menu(main_nav_tmpl.extmpl)" : {
            "file" : "template/people/main_nav_tmpl.extmpl",
            "funcs" : "func_table",
            "fkey" : "$tmpl_lines",
            "${vars}" : "one_shot"
        },
        "$id(${canonical})" : {
            "funcs" : "func_table",
            "fkey" : "$id",
            "${vars}" : "canonical"
        },
        "$gen$unload_entrys_entry_for_undo(${entrys_entry_proto})" : {
            "${el}" : "entrys_entry_proto",
            "${val}" : "t[${el}]",
            "template" : "\t\t\tlet ${el} = entry.${el}"
        },
        "$gen$inline$keys_of(unload_entrys_entry_for_undo,${entrys_entry_proto})" : {
            "${el}" : "entrys_entry_proto",
            "sep"  : ", ",
            "template" : "<{keys}>"
        },
        "$gen$reload_entrys_entry_by_undo(${entrys_entry_proto})" : {
            "${el}" : "entrys_entry_proto",
            "${val}" : "t[${el}]",
            "template" : "\t\t\tentry.${el} = old_values.${el}"
        },
        "$gen$unequal_objects(${entrys_entry_proto})" : {
            "${el}" : "entrys_entry_proto",
            "${val}" : "t[${el}]",
            "skip" : "starts_with_underscore",
            "template" : "\t\t\tif ( save_entry.${el} !== stored_entry.${el} ) return true"
        },
        "$gen$is_ready_to_publish_entrys_entry(assign,${publish_field_requirements})" : {
            "${el}" : "publish_field_requirements",
            "${val}" : "t[${el}]",
            "template" : "\t\t\tlet ${el} = entry.${el}"
        },
        "$gen$is_ready_to_publish_entrys_entry(emptiness,${publish_field_requirements})" : {
            "${el}" : "publish_field_requirements",
            "${val}" : "t[${el}]",
            "template" : "\t\t\tready &&= (${el}.length !== 0)"
        },
        "$gen$is_ready_to_publish_entrys_entry(required,${publish_field_requirements})" : {
            "${el}" : "publish_field_requirements",
            "${val}" : "t[${el}]",
            "template" : "\t\t\t\tif (${el}.length === 0) {\n\t\t\t\t\t user_should_see.${el} = true\n\t\t\t\t}"
        },
        "$load_with_ops:edit_response(setup_edit_response.extmpl)" : {
            "file" : "template/people/setup_edit_response.extmpl",
            "funcs" : "func_table",
            "fkey" : "$tmpl_lines",
            "${vars}" : "one_shot"
        },
        "$load:imports(one_edit_field.html,${edit_field_types[i]})" : {
            "${el}" : "edit_field_types",
            "file" : "template/people/one_edit_field.html"
        }
    },
    "vars" : {
        "concern" : "copious",
        "canonical" : "http://www.copious.world",
        "logo_icon" : "copiousLogo.svg",
        "main_type" : "people",
        "title_role_field" : "title",
        "entrys_entry_classes" : [ "people", "drafts", "published", "trash" ],
        "entries_list_classes" : [ "drafts", "published", "trash" ],
        "entrys_types_to_titles" : {
            "people" : "<b>humans</b> <i>of this World</i> ",
            "drafts" : "<b>Drafts</b>",
            "published" : "<b>Published</b>",
            "trash" : "<b>Trash</b>"
        },
        "entrys_entry_proto" : {
            "id" : 1,
            "author" : "richard@myhost.local", 
            "category" : "cecks",
            "title" : "much to do with tests", 
            "recipient" : "people",
            "date" : "${date_local_string}", 
            "timestamp" : "${timestamp}",
            "created_when" : "${date_local_string}",
            "updated_when" : "${date_local_string}",
            "description" : "this is a test",
            "score" : 1.0,
            "keys" : "sensless,common,often",
            "text" : "edit this message",
            "_count_edits" : 0, "_saved_updates" : []
        },
        "publish_field_requirements" : {
            "author" : true,
            "title" : true,
            "text" : false
        },
        "contact_proto" : {
            "id" : 1, 
            "email" : "", 
            "name" : "", 
            "date" : "${date_local_string}",
            "timestamp" : "${timestamp}",
            "text" : "", 
            "_count_edits" : 0, 
            "_saved_updates" : []  
        },
        "switch_types" : [ "people", "connections", "manage"],
        "edit_field_types" : [ "author", "title" ],
        "switch_links" : {
            "people" : {
                "find people" : { "action" : "entrys_entry_switch_to", "template" : "switch_to_el", "ky" : "people" },
                "spacer1" : "shadow_line"
            },
            "connections" : {
                "connect" : { "action" : "entrys_entry_create()", "template" : "simple_action"},
                "spacer1" : "shadow_line",
                "drafts" : { "action" : "entrys_entry_switch_to", "template" : "switch_to_el"},
                "sent" : { "action" : "entrys_entry_switch_to", "template" : "switch_to_el"},
                "thinking" : { "action" : "entrys_entry_switch_to", "template" : "switch_to_el"}
            }, 
            "manage" : {
                "my ${main_type}" :  { "action" : "search_ui('${main_type}')", "template" : "simple_action"},
                "preferences" :  { "action" : "manage_prefs()", "template" : "simple_action"}
            }
        }
    },
    "templates" : {
        "section_switch" : "            <h4><button onclick=\"toggle_ul(event,'${ctype}')\">${ctype} <span id=\"ardn-${ctype}\" style=\"display:inline-block;color:darkgreen;\">&#x25BC;</span><span id=\"arrt-${ctype}\" style=\"display:none;color:darkgreen;\">&#x25BA;</span></button></h4>",
        "link_panel" : "\t\t\t<ul id=\"ul-${ctype}\">\n\t\t\t\t$gen:list_els(switch_links,${ctype})\n\t\t\t</ul>",
        "switch_to_el" : "<li><button onclick=\"${action}('${ky}')\" >${title}</button></li>",
        "simple_action" : "<li><button onclick=\"${action}\" >${title}</button></li>",
        "shadow_line" : "\n\t\t\t\t<div style=\"height:6px;background-color: rgba(156, 157, 165, 1);margin-bottom:6px\">&nbsp;</div>"
    }
}